# CallBridge Backend Environment Configuration
PORT=3000
NODE_ENV=production

# Twilio Master Credentials (From https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Outbound/Inbound Twilio Phone Number (in E.164 format, e.g. +12025550199)
TWILIO_PHONE_NUMBER=+12025550199

# Twilio TwiML App SID (Created in Twilio Console under Voice -> TwiML Apps)
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio FCM Push Credential SID (Required for Incoming Call Ringing on Android)
TWILIO_PUSH_CREDENTIAL_SID=CRxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public HTTPS Base URL of this Backend (e.g. https://callbridge.up.railway.app)
PUBLIC_BASE_URL=https://your-backend-domain.up.railway.app

# Optional CORS origins (comma-separated or * for mobile clients)
ALLOWED_ORIGINS=*
